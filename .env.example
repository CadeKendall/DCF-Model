# Copy this file to .env only if .env does not already exist.
# Enter the real key in .env, never here or in chat. Git ignores .env.
FMP_API_KEY=

# Optional SEC public-data refresh. Set locally to: DCF-Model your-contact-email
# SEC_USER_AGENT is sent to SEC as the HTTP User-Agent; no SEC API key is needed.
SEC_USER_AGENT=
